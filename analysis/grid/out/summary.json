  "rules": {
    "ibtracs_storm_list": "Named storm (IBTrACS v04r01, main track) from seasons 2018-2025 with a track point within 250 km of the Georgia state polygon. Window (local Eastern dates): from the date of the first track point within 800 km of Georgia's centroid to the date of the last such point plus 7 days. The peak is searched only during passage: from the window start to 24 h after the last track point within 800 km. EAGLE-I coverage ends 2025-12-31.",
    "eaglei_storm_window": "EAGLE-I 15-minute county outages over the storm window (local dates converted to UTC). A timestamp with no GA/FL record at all is a collection gap, and a record with a null value is unknown: both carry the county's last value forward; other missing intervals are 0. Peak = first interval at the maximum during passage. Hours to 90% restored = peak to first interval at or below 10% of peak, searched to 7 days after the window; censored if not reached. Status suspect on rows never used.",
    "eaglei_restore_censored_lower_bound": "Outages never fell to 10% of peak within 7 days after the window: hours from peak to the end of that search, a lower bound on the true restore time.",
    "eaglei_share_capped": "peak_customers_out / EAGLE-I 2024 total customers, capped at 1. Status suspect where the uncapped share exceeds 1 (denominator below the attributed outages) and on rows never used.",
    "eaglei_hours_above_10pct": "Hours in the window with customers out >= 10% of EAGLE-I 2024 total customers. Status suspect where the peak share exceeds 1 (same too-small denominator) and on rows never used.",
    "prior_storm_carryover": "Would-be hit (capped peak share >= 0.1) whose peak precedes the storm's first track point within 800 km of Georgia, or whose county already had >= 50% of that peak out when the window opened: the outage is an earlier event still being restored; kept, never used.",
    "storm_hit": "Usable storm row (not prior-storm carryover) with capped peak share >= 0.1.",
    "storm_not_hit": "Usable storm row with capped peak share < 0.1: the storm did not test this county's grid.",
    "hit_storm_count": "Number and list of the county's hit storms.",
    "hit_storm_median": "Median across the county's hit storms. suspect when any hit storm's input is suspect; low_data when only one storm hit.",
    "hit_storm_worst": "Maximum across the county's hit storms (and the storm it came from). suspect when the maximum comes from a suspect row; low_data when only one storm hit.",
    "no_hit_storm": "No listed storm took 10% or more of the county's customers out: no measurement.",
    "usable_storm_max": "Maximum capped peak share across all usable storm rows (not prior-storm carryover), hit or not: the worst share of customers out the county has recorded in a listed storm.",
    "eia_customer_per_county_weight": "Mean over 2018-2024 utility-years with both IEEE SAIDI values, across utilities whose 2024 EIA-861 service territory includes the county. Each utility weighted by its mean customers / number of Georgia counties it serves (approximate customers per county, assuming an even spread). low_data when some serving utilities file no reliability data.",
    "eia_storm_multiplier": "Weighted SAIDI with major event days / weighted SAIDI without major event days.",
    "eia_no_reporting_utility": "No utility serving the county filed SAIDI in EIA-861 for the period.",
    "eia_utility_count": "Utilities whose 2024 EIA-861 service territory lists the county, and how many of them filed SAIDI.",
    "eia_baseline_terciles": "Baseline only, no storm test. Composite = mean of percent ranks of weighted SAIDI with major event days and the storm multiplier among counties with both; top third LOW, bottom third HIGH. Utility-wide annual figures, not a county storm measurement.",
    "tier_fixed_thresholds": "LOW: worst peak share >= 0.5 and worst hours to 90% restored >= 72. HIGH: worst peak share < 0.25 and worst hours to 90% restored < 24. MEDIUM: otherwise. UNKNOWN: no hit storm. suspect when the worst peak share is suspect.",
    "tier_terciles": "Composite = mean of percent ranks of worst peak share and worst hours to 90% restored among tiered counties; top third LOW, bottom third HIGH.",
    "tier_median_thresholds": "Fixed-threshold rule applied to the median across hit storms instead of the worst.",
    "tier_stable_all_rules": "True when the fixed-threshold, tercile and median rules give the same tier.",
    "empower_snapshot": "power_dependent_dme from the team's c4data Georgia power_dependent_counties snapshot."
  }
